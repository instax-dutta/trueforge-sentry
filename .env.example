# SENTRY runtime environment — placeholders only. Copy to .env and fill real values.
# NEVER commit .env. Never paste real values into issues, PRs, screenshots, or the demo video.

# --- Model gateway (personal OpenAI-compatible endpoint) ---
MODEL_GATEWAY_BASE_URL=https://omni.aeglyn.site/v1
MODEL_GATEWAY_API_KEY=placeholder            # if gateway requires one; leave as-is if keyless

# Model roles (FQN used in agent.json / UI provider config)
MODEL_DEV=oc/nemotron-3.5-lightning-free
MODEL_DEV_ALT=ollama-cloud/minimax-m3
MODEL_DEMO=oc/nemotron-3-ultra-free
MODEL_FALLBACK_1=oc/hy3-free
MODEL_FALLBACK_2=oc/x-preview-f-free

# --- TrueForge hosted mode (upstream clone packages/trueforge/.env) ---
POSTGRES_USER=placeholder
POSTGRES_PASSWORD=placeholder
POSTGRES_DB=placeholder
PUBLIC_BASE_URL=http://localhost:8791        # change only if exposed beyond loopback

# --- Victim stack ---
SHOP_PORT=3000
CHAOS_LATENCY_MS=0                           # 0 = healthy; e.g. 2000 during bad-deploy scenario
CHAOS_ERROR_RATE=0                           # 0..1 fraction of 5xx responses
SHOP_VERSION=v1                              # v1 | bad (chaos inject swaps this)

# --- Observability ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin                     # local-only creds, still never published real ones
GRAFANA_ADMIN_PASSWORD=placeholder

# --- MCP connectors ---
GRAFANA_TOKEN=placeholder                    # grafana service-account token (header auth)
GITHUB_MCP_PAT=placeholder                   # fallback if OAuth flaky; prefer OAuth DCR
KUBECONFIG_PATH=~/.kube/config               # kind cluster context, if k8s path activated

# --- sdk-hooks (stretch) ---
ALERTMANAGER_WEBHOOK_SECRET=placeholder      # bearer token for receiver
